# Copy to `.env` for local development. Never commit a real `.env`.
# These settings are read starting in Phase 6 (OpenAI extraction). They are unused in Phase 1.

# OpenAI API key. Required only when EXTRACTOR=openai.
OPENAI_API_KEY=

# Vision-capable model with structured-output support (chosen in Phase 6).
OPENAI_MODEL=

# Document extractor: "fake" (offline fixtures) or "openai".
EXTRACTOR=fake
